      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Clear Props" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// List of properties to clear and clear them...
/*def propsToClear = [&apos;itercntrclass&apos;]

propsToClear.each { key -&gt;
    if (props.get(key) != null) {
        log.info(&quot;Clearing property: ${key}&quot;)
        props.remove(key)  // Removes the property
    }
}*/

// Or do this...
props.clear()
</stringProp>
        </JSR223Sampler>
